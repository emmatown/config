{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"git+file://${workspaceFolder}\").inputs.nixpkgs { system = \"aarch64-darwin\"; }",
      },
      "formatting": {
        "command": ["nixfmt"],
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"git+file://${workspaceFolder}\").nixosConfigurations.mini.options",
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"git+file://${workspaceFolder}\").homeConfigurations.\"emma-darwin\".options",
        },
      },
    },
  },
}
